@{
	User? loggedInUser = (User?)ViewData["LoggedInUser"];
	ViewData["Title"] = "Tickets Overview";
	long totalTickets, totalOpenTickets, totalResolvedTickets, totalClosedTickets;
	double openPercentage, resolvedPercentage, closedPercentage;
	if (loggedInUser.Role == Role.RegularEmployee)
	{
		totalTickets = (long)ViewData["TotalTickets"];
		totalOpenTickets = (long)ViewData["TotalOpenTickets"];
		totalResolvedTickets = (long)ViewData["TotalResolvedTickets"];
		totalClosedTickets = (long)ViewData["TotalClosedTickets"];

		openPercentage = (double)totalOpenTickets / (int)totalTickets * 100;
		resolvedPercentage = (double)totalResolvedTickets / (int)totalTickets * 100;
		closedPercentage = (double)totalClosedTickets / (int)totalTickets * 100;
	}
	else { 
	totalTickets = (long)ViewData["TotalAllTickets"];
	totalOpenTickets = (long)ViewData["TotalAllOpenTickets"];
	totalResolvedTickets = (long)ViewData["TotalAllResolvedTickets"];
	totalClosedTickets = (long)ViewData["TotalAllClosedTickets"];

	 openPercentage = (double)totalOpenTickets / (int)totalTickets * 100;
	 resolvedPercentage = (double)totalResolvedTickets / (int)totalTickets * 100;
	 closedPercentage = (double)totalClosedTickets / (int)totalTickets * 100;
	}
	
}

<div class="main-container d-flex flex-row">
	<partial name="_SideBar"></partial>

	<div style="width:80%" class="d-flex flex-column">
		<div class="d-flex flex-column text">
			<div>
				<h1 class="ms-2 mb-5 mt-1">Tickets Overview</h1>
			</div>
			
			<div class="d-flex flex-row text-center justify-content-evenly">
				<div class="circular-progress progress-open">
					<p><b>Open tickets:</b></p>
					<svg class="circular-progress-svg" viewBox="0 0 36 36">
						<path class="circular-progress-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
						<path class="circular-progress-fg"
							  stroke-dasharray="100"
							  stroke-dashoffset="@(100 - openPercentage)"
							  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
					</svg>
					<div class="circular-progress-text">@totalOpenTickets / @totalTickets</div>
				</div>

				<div class="circular-progress progress-resolved">
					<p><b>Resolved tickets:</b></p>
					<svg class="circular-progress-svg" viewBox="0 0 36 36">
						<path class="circular-progress-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
						<path class="circular-progress-fg"
							  stroke-dasharray="100"
							  stroke-dashoffset="@(100 - resolvedPercentage)"
							  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
					</svg>
					<div class="circular-progress-text">@totalResolvedTickets / @totalTickets</div>
				</div>

				<div class="circular-progress progress-closed">
					<p><b>Closed tickets:</b></p>
					<svg class="circular-progress-svg" viewBox="0 0 36 36">
						<path class="circular-progress-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
						<path class="circular-progress-fg"
							  stroke-dasharray="100"
							  stroke-dashoffset="@(100 - closedPercentage)"
							  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
					</svg>
					<div class="circular-progress-text">@totalClosedTickets / @totalTickets</div>
				</div>
			</div>
		</div>
	</div>
</div>

