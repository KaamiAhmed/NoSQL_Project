@model IncidentManagementSystem.Models.Ticket

@{
    User? loggedInUser = (User?)ViewData["LoggedInUser"];
    ViewData["Title"] = "Create New Incident";
    var employees = ViewBag.RegularEmployees as List<IncidentManagementSystem.Models.User> ?? new List<IncidentManagementSystem.Models.User>();
}

<div class="content-area flex-grow-1 bg-light p-5 d-flex flex-column align-items-center">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-dark">Create New Incident</h1>
    </div>

    <div class="card shadow-lg border-0" style="max-width: 750px; width: 100%;">
        <div class="card-body p-4">
            <form asp-action="CreateIncident" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Title</label>
                    <input asp-for="Title" class="form-control" placeholder="Enter a clear title for the incident" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the issue in detail..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TypeOfIncident" class="form-label fw-semibold">Type of Incident</label>
                    <select asp-for="TypeOfIncident" class="form-select">
                        <option value="">Select Type</option>
                        @foreach (var type in Enum.GetValues(typeof(TypeOfIncident)))
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                    <span asp-validation-for="TypeOfIncident" class="text-danger small"></span>
                </div>
                @if(loggedInUser.Role == Role.ServiceDeskEmployee){
                
                    <div class="mb-3">
                        <label asp-for="ReportedBy" class="form-label fw-semibold">Reported By</label>
                        <select asp-for="ReportedBy" class="form-select" required>
                            <option value="">Select Employee</option>
                            @foreach (var emp in ViewBag.RegularEmployees)
                            {
                                var fullName = emp.Name != null
                                ? $"{emp.Name.FirstName} {emp.Name.LastName}"
                                : "(Unknown Name)";
                                <option value="@emp.Id">@fullName</option>
                            }
                        </select>
                        <span asp-validation-for="ReportedBy" class="text-danger small"></span>
                    </div>


                <div class="mb-3">
                    <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="">Select Priority </option>
                        @foreach (var priority in Enum.GetValues(typeof(Priority)))
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                    <span asp-validation-for="Priority" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                        <label asp-for="AssignedTo.UserId" class="form-label fw-semibold">Assign To</label>
                        <select asp-for="AssignedTo.UserId" class="form-select">
                            <option value="">Select Service Desk Employee </option>
                            @foreach (var emp in ViewBag.ServiceDeskEmployees)
                            {
                                var fullName = emp.Name != null
                                ? $"{emp.Name.FirstName} {emp.Name.LastName}"
                                : emp.UserName;
                                <option value="@emp.Id">@fullName</option>
                            }
                        </select>
                        <span asp-validation-for="AssignedTo.UserId" class="text-danger small"></span>
                    </div>


                }

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success px-4 me-2 shadow-sm">Create Incident</button>
                    <a asp-action="GetMyTickets" asp-controller="Ticket" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
