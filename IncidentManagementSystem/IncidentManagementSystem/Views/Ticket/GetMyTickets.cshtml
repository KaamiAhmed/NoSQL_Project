@model List<IncidentManagementSystem.Models.Ticket>
@{
	//User? loggedInUser = (User?)ViewData["LoggedInUser"];
	ViewData["Title"] = "Tickets";
}

<div class="main-container d-flex flex-row">
	<partial name="_SideBar"></partial>

	<div style="width:80%">
		<h1 class="ms-2 mt-1 mb-3">My Tickets</h1>
		@* @if (@ViewBag.NoTickets != null)
		{
			<div class="alert alert-info">@ViewBag.NoTickets</div>
		} *@
		@{
			int count = 1;
		}
		@foreach (Ticket ticket in Model)
		{
			string bgColor = "";
			@if (ticket.Status == Status.Open)
			{
				bgColor = "bg-info";
			}
			else if (ticket.Status == Status.Resolved)
			{
				bgColor = "bg-success";
			}
			else
			{
				bgColor = "bg-danger";
			}

			var collapseId = $"collapse{ticket.Id}";

			<div class="accordion" id="accordion">
				<div class="accordion-item">
					<h2 class="accordion-header">
						<button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="true" aria-controls="@collapseId">
							<p>@count: <b>Title:</b> @ticket.Title</p>
						</button>
					</h2>
					<div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#accordion">
						<div class="accordion-body">
							<p><b>Description:</b> @ticket.Description</p>
							<p><b>Status:</b> <span class="badge @bgColor">@ticket.Status</span></p>
							<small class="text-muted">@ticket.DateOfEvent</small>
						</div>
					</div>
				</div>
			</div>
			count++;
		}
	</div>
</div>