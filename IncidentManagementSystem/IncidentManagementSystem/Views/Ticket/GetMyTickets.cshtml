@model List<IncidentManagementSystem.Models.Ticket>
@{
	User? loggedInUser = (User?)ViewData["LoggedInUser"];
	ViewData["Title"] = "Tickets";
}

<div class="main-container d-flex flex-row">
	<partial name="_SideBar"></partial>

	<div style="width:80%;height:90vh;overflow-y:auto;">
		<div class="d-flex justify-content-between align-items-center ms-2 mt-1 mb-3">
			@if (loggedInUser != null && loggedInUser.Role == Role.RegularEmployee)
			{
				<h1>My Incidents</h1>
			}
			else
			{
				<h1>All Incidents</h1>
			}

			@if (loggedInUser != null && loggedInUser.Role != Role.Admin)
			{
				<a asp-action="CreateIncident" asp-controller="Ticket" class="btn btn-primary me-3">+ Add Incident</a>
			}
		</div>
		<form method="get" action="/Ticket/GetMyTickets" class="d-flex mb-4 ms-2">
			<input class="w-25 me-2" type="search" name="searchWord" placeholder="Search by Title or Description" value="@ViewData["CurrentFilter"]" />
			<button class="btn btn-outline-success" type="submit">Search</button>
		</form>
		@if (ViewBag.NoTickets != null)
		{
			<div class="alert alert-info">@ViewBag.NoTickets</div>
		}
		@{
			int count = 1;
		}
		@foreach (Ticket ticket in Model)
		{
			string bgColor = "";
			@if (ticket.Status == Status.Open)
			{
				bgColor = "bg-info";
			}
			else if (ticket.Status == Status.Resolved)
			{
				bgColor = "bg-success";
			}
			else
			{
				bgColor = "bg-danger";
			}

			var collapseId = $"collapse{ticket.Id}";

			<div class="accordion" id="accordion">
				<div class="accordion-item">
					<h2 class="accordion-header">
						<button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="true" aria-controls="@collapseId">
							<p>@count: <b>Title:</b> @ticket.Title</p>
						</button>
					</h2>
					<div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#accordion">
						<div class="accordion-body">
							<p><b>Description:</b> @ticket.Description</p>
							@if (loggedInUser != null && loggedInUser.Role == Role.ServiceDeskEmployee)
							{
								if (ticket.Status == Status.Closed)
								{
									<p><b>Status:</b> <span class="badge @bgColor">@ticket.Status</span></p>
								}
								else
								{
									<p>
										<b>Status:</b>
										<select class="form-select form-select-sm status-dropdown @bgColor text-white"
												data-ticket-id="@ticket.Id"
												style="width: auto; display: inline-block; font-weight: 600; border: none; box-shadow: none;">
											<option value="Open" selected="@(ticket.Status == Status.Open)">Open</option>
											<option value="Resolved" selected="@(ticket.Status == Status.Resolved)">Resolved</option>
											<option value="Closed" selected="@(ticket.Status == Status.Closed)">Closed</option>
										</select>
									</p>
								}
							}
							else
							{
								<p><b>Status:</b> <span class="badge @bgColor">@ticket.Status</span></p>
							}

							<p><b>Deadline:</b> @ticket.Deadline</p>
                            <p><b>Priority:</b> @ticket.Priority</p>

							@if(loggedInUser!=null && loggedInUser.Role== Role.ServiceDeskEmployee )
							{
							 <p><b>Reported By:</b> @ticket.ReportedByName</p>
								<p>
									<b>Assigned To:</b> @(ticket.AssignedTo != null && !string.IsNullOrWhiteSpace(ticket.AssignedTo.FirstName)
																? $"{ticket.AssignedTo.FirstName} {ticket.AssignedTo.LastName}"
																: "Not Assigned")
						        </p>
							}							
							<small class="text-muted">@ticket.DateOfEvent</small>
							@if (loggedInUser != null && loggedInUser.Role == Role.ServiceDeskEmployee)
							{
								<div class="mt-2 text-end">
								@if (ticket.Status == Status.Closed)
								{									
									<button class="btn btn-sm btn-outline-secondary opacity-50" disabled>
										<i class="bi bi-pencil-square"></i> Update
										</button>
									}
									else
									{
										<a class="btn btn-sm btn-outline-primary" href="/Ticket/UpdateIncident/@ticket.Id">
											<i class="bi bi-pencil-square"></i> Update
										</a>
									}
									
								</div>
							}
						</div>
					</div>
				</div>
			</div>
			count++;
		}
	</div>
</div>
@section Scripts {
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script>
		$(document).ready(function () {
			$('.status-dropdown').on('change', function () {
				var ticketId = $(this).data('ticket-id');
				var newStatus = $(this).val();
				var dropdown = $(this);

				
				dropdown.removeClass('bg-info bg-success bg-danger');

				if (newStatus === 'Open') dropdown.addClass('bg-info');
				else if (newStatus === 'Resolved') dropdown.addClass('bg-success');
				else dropdown.addClass('bg-danger');


				
				$.ajax({
					url: '/Ticket/UpdateStatus',
					type: 'POST',
					data: { id: ticketId, status: newStatus },
					success: function (response) {
						if (!response.success) {
							alert('Failed to update status.');
						}
					},
					error: function () {
						alert('Error updating status.');
					}
				});
			});
		});
	</script>
}

