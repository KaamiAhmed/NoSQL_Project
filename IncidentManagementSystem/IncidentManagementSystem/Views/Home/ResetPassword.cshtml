@model IncidentManagementSystem.Models.ResetPasswordViewModel
@{
	Layout = "/Views/Shared/_LoginLayout.cshtml";
}
@if (ViewBag.Error != null)
{
	<div class="alert alert-danger">@ViewBag.Error</div>
}
<form action="/Home/ResetPassword" method="post">
	<label for="NewPassword">Enter your new Password:</label>
	<input type="hidden" name="token" value="@Model.Token" />
	<input id="NewPassword" name="newPassword" type="password" required/>

	<label for="ConfirmPassword">Confirm Password:</label>
	<input id="ConfirmPassword" name="confirmPassword" type="password" required/>
	<p id="validation"></p>
	<button type="submit" class="btn btn-primary mt-3" disabled>Reset Password</button>
</form>

<script>
	const newPass = document.getElementById("NewPassword");
	const confirmPass = document.getElementById("ConfirmPassword");
	const validation = document.getElementById("validation");
	const button = document.querySelector("button")
	function checkPasswords(e){
		const newPassValue = newPass.value;
		const confirmPassValue = confirmPass.value;
		if(newPassValue !== confirmPassValue){
			validation.style.color = "red";
			validation.textContent = "Password does not match";
			button.disabled = true;
			e.preventDefault();
		}
		else{
			validation.style.color = "green";
			validation.textContent = "Password matches";
			button.disabled = false;
		}
	};
	confirmPass.addEventListener("input", checkPasswords);
</script>