@model IncidentManagementSystem.Models.User
@{
    ViewData["Title"] = "Delete User";
    var assignedCount = (ViewBag.AssignedCount as int?) ?? 0;
}

<h2 class="mb-4 text-center text-danger">@ViewData["Title"]</h2>

@if (assignedCount > 0)
{
    <div class="alert alert-info">
        This user currently has <b>@assignedCount</b> ticket@(assignedCount == 1 ? "" : "s") assigned.
        They will be marked as <b>Not assigned yet</b> after deletion.
    </div>
}

<div class="border rounded p-4 shadow-sm bg-light">
    <p class="text-center fs-5 mb-4">Are you sure you want to delete this user?</p>

    <ul class="list-group mb-4">
        <li class="list-group-item"><strong>Username:</strong> @Model.UserName</li>
        <li class="list-group-item"><strong>Name:</strong> @Model.Name?.FirstName @Model.Name?.LastName</li>
        <li class="list-group-item"><strong>Email:</strong> @Model.Email</li>
        <li class="list-group-item"><strong>Role:</strong> @Model.Role</li>
        <li class="list-group-item"><strong>Branch:</strong> @Model.Branch</li>
    </ul>

    <form asp-action="DeleteConfirmed" method="post" id="deleteForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="ack" />
            <label class="form-check-label" for="ack">
                I understand that deleting this user will unassign
                <b>@assignedCount</b> ticket@(assignedCount == 1 ? "" : "s").
            </label>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger" id="deleteBtn" disabled>Delete</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const ack = document.getElementById('ack');
        const btn = document.getElementById('deleteBtn');
        const form = document.getElementById('deleteForm');
        ack.addEventListener('change', () => btn.disabled = !ack.checked);

        form.addEventListener('submit', (e) => {
          const count = @assignedCount;
          const msg = count > 0
            ? `This will unassign ${count} ticket${count === 1 ? '' : 's'}. Continue?`
            : `Are you sure you want to delete this user?`;
          if (!confirm(msg)) e.preventDefault();
        });
    </script>
}
