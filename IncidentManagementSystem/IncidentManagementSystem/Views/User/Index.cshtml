@model List<IncidentManagementSystem.Models.User>
@{
	// User? loggedInUser = (User?)ViewData["LoggedInUser"];
}


<div class="main-container d-flex flex-row">
	<partial name="_SideBar"></partial>
	<div style="width:80%">
		<h2>Users</h2>

		<p>
			<a class="btn btn-primary" asp-action="Create">Create New User</a>
		</p>

		<table class="table table-striped">
			<thead>
				<tr>
					<th>UserName</th>
					<th>Name</th>
					<th>Email</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var user in Model)
				{
					<tr>
						<td>@user.UserName</td>
						<td>@user.Name</td>
						<td>@user.Email</td>
						<td>
							<a class="btn btn-info btn-sm" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
							<a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@user.Id">Delete</a>
							<a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@user.Id">Details</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>